# Copy to .env and fill in. Never commit .env.

# --- Advisor (chat): OpenAI-compatible providers, tried in order until one answers ---
GROQ_API_KEY=              # https://console.groq.com  (free: 1,000 req/day, 8k tokens/min on gpt-oss-120b)
ADVISOR_MODEL_GROQ=openai/gpt-oss-120b
CEREBRAS_API_KEY=          # optional backup, https://cloud.cerebras.ai (may ask for a card in some regions; skip it if so)
ADVISOR_MODEL_CEREBRAS=gpt-oss-120b
MISTRAL_API_KEY=           # optional backup, https://console.mistral.ai "Experiment" plan: free, phone verification, no card
ADVISOR_MODEL_MISTRAL=mistral-small-latest
OPENROUTER_API_KEY=        # optional backup, https://openrouter.ai/keys : free models, no card, 50 requests/day
ADVISOR_MODEL_OPENROUTER=openai/gpt-oss-120b:free
ADVISOR_PROVIDER_CHAIN=groq,cerebras,mistral,openrouter,gemini   # tried in this order; providers without a key are skipped
#   with a paid Gemini key, use ADVISOR_PROVIDER_CHAIN=gemini,groq and GEMINI_MODEL=gemini-3.5-flash-lite (about Rs 0.65 a conversation)
ADVISOR_REASONING_EFFORT=medium               # gpt-oss only; "low" is cheaper but skipped tool calls on Hindi input
ADVISOR_MAX_WAIT_S=20                         # if every provider is rate-limited, wait at most this long before the offline reply
# ADVISOR_OFFLINE=1                           # demo rehearsal without network: serve cached replies / engine-only text

# --- Mobile verification (OTP) ---
SMS_PROVIDER=demo             # demo | messagecentral | 2factor. demo = no SMS sent, the code is shown on screen (still random per request)
MC_CUSTOMER_ID=               # Message Central VerifyNow (console.messagecentral.com, no card, no DLT of your own): C-XXXXXXXX
MC_EMAIL=                     #   the email you signed up with
MC_PASSWORD=                  #   the account password (sent base64-encoded to their token API; never logged)
TWOFACTOR_API_KEY=            # 2Factor.in (backup provider), from the 2factor.in dashboard
TWOFACTOR_TEMPLATE=           #   optional; empty = their default OTP template
OTP_SECRET=                   # HMAC key for hashing codes and numbers; if empty, one is generated in backend/data/.otp_secret
REQUIRE_OTP=0                 # 1 = POST /sessions needs a verified otp_token (the UI always verifies; 0 keeps the API easy to test)
# OTP_TTL_S=300  OTP_MAX_ATTEMPTS=5  OTP_RESEND_COOLDOWN_S=30  OTP_MAX_PER_HOUR=5  OTP_MAX_PER_IP_HOUR=20

# --- Back office ---
STAFF_PIN=                    # required to open the back-office page; no default

# --- Gemini: KYC document vision (and last-resort advisor fallback) ---
GEMINI_API_KEY=            # from https://aistudio.google.com/apikey  (free: 20 req/day per model)
GEMINI_MODEL=gemini-3.5-flash-lite     # used when the advisor falls back to Gemini
GEMINI_VISION_MODEL=gemini-3.5-flash-lite   # KYC document extraction; 2.5-flash-lite is not available to new keys
TODAY=2026-07-15                       # "today" for all date checks, per the dataset README
GEMINI_MIN_INTERVAL_S=13               # free tier = 5 requests/min; set 0 once billing is enabled
BACKEND_URL=http://localhost:8000
